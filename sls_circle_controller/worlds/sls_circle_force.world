<?xml version="1.0"?>
<sdf version="1.6">
  <world name="sls_circle_force">
    <!-- 简化 Gazebo 烟测 world：验证外力闭环和吊载响应，不包含 PX4 内环或电机模型。 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <physics name="ode_physics" type="ode">
      <!-- 较小步长用于减轻吊载关节数值发散，CPU 负载会比普通空世界更高。 -->
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <model name="sls_circle_drone">
      <pose>0 0 1.6 0 0 0</pose>
      <link name="base_link">
        <!-- base_link 代表无人机本体，质量要和控制器 mav_mass/bridge_mass 保持一致。 -->
        <inertial>
          <mass>1.56</mass>
          <inertia>
            <ixx>0.018</ixx>
            <iyy>0.018</iyy>
            <izz>0.030</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.18</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="body">
          <geometry>
            <box>
              <size>0.42 0.42 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.8 1</ambient>
            <diffuse>0.1 0.3 0.8 1</diffuse>
          </material>
        </visual>
        <velocity_decay>
          <linear>0.01</linear>
          <angular>0.01</angular>
        </velocity_decay>
      </link>

      <link name="pendulum">
        <!-- pendulum 是轻质量吊绳近似，用 universal joint 提供两个方向摆动自由度。 -->
        <pose>0 0 -0.32 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.00060208</ixx>
            <iyy>0.00060208</iyy>
            <izz>0.000000005</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <visual name="pendulum_visual">
          <geometry>
            <cylinder>
              <radius>0.01</radius>
              <length>0.85</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
        <velocity_decay>
          <linear>0.01</linear>
          <angular>0.02</angular>
        </velocity_decay>
      </link>

      <link name="load">
        <!-- load 是吊载球，质量要和控制器 load_mass 对齐。 -->
        <pose>0 0 -0.745 0 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.0000625</ixx>
            <iyy>0.0000625</iyy>
            <izz>0.0000625</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <collision name="load_collision">
          <geometry>
            <sphere>
              <radius>0.08</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="load_visual">
          <geometry>
            <sphere>
              <radius>0.08</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.8 0.2 0.1 1</diffuse>
          </material>
        </visual>
        <velocity_decay>
          <linear>0.01</linear>
          <angular>0.02</angular>
        </velocity_decay>
      </link>

      <joint name="load_joint" type="ball">
        <parent>pendulum</parent>
        <child>load</child>
        <pose>0 0 0 0 0 0</pose>
      </joint>

      <joint name="pendulum_joint" type="universal">
        <!-- universal joint 用两个互相垂直的转轴模拟绳摆，阻尼过低会让烟测更容易发散。 -->
        <parent>base_link</parent>
        <child>pendulum</child>
        <pose>0 0 0.425 0 0 0</pose>
        <axis>
          <xyz>1 0 0</xyz>
          <dynamics>
            <damping>0.08</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
        <axis2>
          <xyz>0 1 0</xyz>
          <dynamics>
            <damping>0.08</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis2>
      </joint>

      <plugin name="gazebo_ros_p3d" filename="libgazebo_ros_p3d.so">
        <!-- 发布机体 odom，桥接节点再转成 /mavros/local_position/*。 -->
        <ros>
          <remapping>odom:=/sls_circle/gazebo_odom</remapping>
        </ros>
        <body_name>base_link</body_name>
        <update_rate>200</update_rate>
        <xyz_offset>0 0 0</xyz_offset>
        <rpy_offset>0 0 0</rpy_offset>
        <gaussian_noise>0.0</gaussian_noise>
      </plugin>

      <plugin name="gazebo_ros_p3d_load" filename="libgazebo_ros_p3d.so">
        <!-- 发布负载 odom，use_load_pose=true 时控制器会把它用于 QSF 状态估计。 -->
        <ros>
          <remapping>odom:=/sls_circle/gazebo_load_odom</remapping>
        </ros>
        <body_name>load</body_name>
        <update_rate>200</update_rate>
        <xyz_offset>0 0 0</xyz_offset>
        <rpy_offset>0 0 0</rpy_offset>
        <gaussian_noise>0.0</gaussian_noise>
      </plugin>

      <plugin name="gazebo_ros_force" filename="libgazebo_ros_force.so">
        <!-- 接收 /sls_circle/gazebo_force，在世界系对 base_link 直接施加合力。 -->
        <ros>
          <remapping>gazebo_ros_force:=/sls_circle/gazebo_force</remapping>
        </ros>
        <link_name>base_link</link_name>
        <force_frame>world</force_frame>
      </plugin>
    </model>
  </world>
</sdf>
