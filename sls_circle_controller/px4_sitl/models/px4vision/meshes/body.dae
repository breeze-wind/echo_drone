<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="millimeter" meter="0.001"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_geometries>
    <geometry id="body_box" name="body_box">
      <mesh>
        <source id="body_positions">
          <float_array id="body_positions_array" count="24">-180 -180 -55 180 -180 -55 180 180 -55 -180 180 -55 -180 -180 55 180 -180 55 180 180 55 -180 180 55</float_array>
          <technique_common>
            <accessor source="#body_positions_array" count="8" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="body_vertices">
          <input semantic="POSITION" source="#body_positions"/>
        </vertices>
        <triangles count="12">
          <input semantic="VERTEX" source="#body_vertices" offset="0"/>
          <p>0 1 2 0 2 3 4 6 5 4 7 6 0 4 5 0 5 1 1 5 6 1 6 2 2 6 7 2 7 3 3 7 4 3 4 0</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="scene" name="scene">
      <node id="body" name="body">
        <instance_geometry url="#body_box"/>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#scene"/>
  </scene>
</COLLADA>
