<?xml version='1.0'?>
<sdf version='1.6'>
  <!-- PX4 SITL 吊载模型：主体来自 px4vision_ancl，当前文件额外挂接吊绳和负载。 -->
  <enable_lockstep>false</enable_lockstep>
  <model name='px4vision_sls'>
  <static>false</static>
  <!-- px4vision_ancl 内部包含 PX4/Gazebo 多旋翼主体和相关插件，本文件通过 include 复用。 -->
  <include>
    <uri>model://px4vision_ancl</uri>
    <pose>0 0 0.105 0 0 0</pose>
  </include>

  <!-- <link name='battery'>
    <pose>0 0 0.071</pose>
    <inertial>
      <mass>0.6</mass>
      <inertia>
        <ixx>0.00021816</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.0011</iyy>
        <iyz>0</iyz>
        <izz>0.0010</izz>
      </inertia>
    </inertial>
    <collision name='battery_collision'>
      <geometry>
        <box>
          <size>0.138 0.046 0.048</size>
        </box>
      </geometry>      
    </collision>
    <visual name='battery_visual'>
      <geometry>
        <box>
          <size>0.138 0.046 0.048</size>
        </box>
      </geometry>
      <material>
        <script>
          <name>Gazebo/DarkGrey</name>
          <uri>file://media/materials/scripts/gazebo.material</uri>
        </script>
      </material>
    </visual>
  </link> -->

  <link name='pendulum'>
    <!-- 轻质量吊绳近似，位置和长度需要与控制器 cable_length 保持一致。 -->
    <!-- <pose>-0.425 0 0 0 1.57 0</pose> -->
    <!-- <pose>0 0 -0.425 0 0 0</pose> -->
    <pose>0 0 -0.32 0 0 0</pose>
    <inertial>
      <mass>0.01</mass>
      <inertia>
        <ixx>0.00060208</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.00060208</iyy>
        <iyz>0</iyz>
        <izz>0.000000005</izz>
      </inertia>
    </inertial>
    <!-- <collision name='pendulun_collision'>
      <geometry>
        <cylinder>
          <radius>0.01</radius>
          <length>0.85</length>
        </cylinder>
      </geometry>
      <surface>
        <contact>
          <ode/>
        </contact>
        <friction>
          <ode/>
        </friction>
      </surface>
    </collision> -->
    <visual name='pendulum_visual'>
      <geometry>
        <cylinder>
          <radius>0.001</radius>
          <length>0.85</length>
        </cylinder>
      </geometry>
      <material>
        <script>
          <name>Gazebo/White</name>
          <uri>file://media/materials/scripts/gazebo.material</uri>
        </script>
      </material>
    </visual>
    <gravity>1</gravity>

  </link>

  <link name='load'>
    <!-- 吊载质量默认 0.25 kg，对应控制器 load_mass。 -->
    <!-- <pose>-0.85 0 0 0 1.57 0</pose> -->
    <!-- <pose>0 0 -0.85 0 0 0</pose> -->
    <pose>0 0 -0.745 0 0 0</pose>
    <inertial>
      <!-- <mass>0.25</mass> -->
      <mass>0.25</mass>
      <inertia>
        <ixx>0.0000625</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.0000625</iyy>
        <iyz>0</iyz>
        <izz>0.0000625</izz>
      </inertia>
    </inertial>
    <!-- <collision name='load_collision'>
      <geometry>
        <sphere>
          <radius>0.025 0.025 0.025</radius>
        </sphere>
      </geometry>
      <surface>
        <contact>
          <ode/>
        </contact>
        <friction>
          <ode/>
        </friction>
      </surface>
    </collision> -->
    <visual name='load_visual'>
      <geometry>
        <sphere>
          <radius>0.025 0.025 0.025</radius>
        </sphere>
      </geometry>
      <material>
        <script>
          <name>Gazebo/Red</name>
          <uri>file://media/materials/scripts/gazebo.material</uri>
        </script>
      </material>
    </visual>
    <gravity>1</gravity>
  </link>

  <joint name='load_joint' type='ball'>
    <!-- 负载和吊绳之间使用 ball joint，允许三维摆动。 -->
    <pose>0 0 0.0 0 0 0</pose>
    <child>load</child>
    <parent>pendulum</parent>
  </joint>

  <joint name='pendulum_joint' type='ball'>
    <!-- 吊绳上端连接到 px4vision_ancl::base_link。 -->
    <pose>0 0 0.425 0 0 0</pose>
    <child>pendulum</child>
    <parent>px4vision_ancl::base_link</parent>
  </joint>

  <!-- <joint name='battery_joint' type='fixed'>
    <pose>0 0 0.0 0 0 0</pose>
    <child>battery</child>
    <parent>px4vision::base_link</parent>
  </joint>   -->
  <!-- GUI 风力只作为 Gazebo 外扰；姿态和电机仍由 PX4 SITL 闭环控制。 -->
  <plugin name="px4_gazebo_wind_force" filename="libgazebo_ros_force.so">
    <ros>
      <remapping>gazebo_ros_force:=/sls_circle/px4_wind_force</remapping>
    </ros>
    <link_name>px4vision_ancl::base_link</link_name>
    <force_frame>world</force_frame>
  </plugin>


  </model>
</sdf>
