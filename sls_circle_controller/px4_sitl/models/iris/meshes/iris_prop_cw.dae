<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_geometries>
    <geometry id="prop" name="prop">
      <mesh>
        <source id="prop_positions">
          <float_array id="prop_positions_array" count="12">-0.18 -0.018 0 0.18 -0.018 0 0.18 0.018 0 -0.18 0.018 0</float_array>
          <technique_common>
            <accessor source="#prop_positions_array" count="4" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="prop_vertices">
          <input semantic="POSITION" source="#prop_positions"/>
        </vertices>
        <triangles count="2">
          <input semantic="VERTEX" source="#prop_vertices" offset="0"/>
          <p>0 1 2 0 2 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="scene" name="scene">
      <node id="prop" name="prop">
        <instance_geometry url="#prop"/>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#scene"/>
  </scene>
</COLLADA>
