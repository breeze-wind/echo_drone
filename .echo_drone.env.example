# 本文件是现场联调变量示例；复制为 .echo_drone.env 后会被 run_echo_drone.sh 自动读取。
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=1
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS2_DISCOVERY_SPIN_TIME=3.0

# 推荐优先依赖脚本自动探测串口；如果现场设备号固定，再取消下面一行注释。
# FCU_URL=/dev/ttyACM0:230400

# 只改波特率时可以不写 FCU_URL，脚本会自动拼成 <探测到的串口>:<FCU_BAUD>。
FCU_BAUD=230400

# 真实控制入口仍需要显式确认；不建议默认写入自动解锁确认。
# CONFIRM_SLS_REAL_CONTROL=I_UNDERSTAND
# CONFIRM_SLS_AUTO_TAKEOFF=I_UNDERSTAND
